APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_center

MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=your-api-key
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's native output size. HNSW vector indexes support <= 2000 dimensions.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
MODEL_TIMEOUT_SECONDS=60

VECTOR_STORE=pgvector
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
MAX_CONTENT_LENGTH=100000

# Docker Compose host ports; DATABASE_URL inside the API container is set by Compose.
POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO
